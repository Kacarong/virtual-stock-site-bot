# ============================================================
#  virtual-stock-site-bot  환경 변수 예시
#  실제 .env 파일을 만들고 값을 채워서 사용하세요 (cp .env.example .env)
# ============================================================

# --- 공통 ---
# 세션 쿠키/JWT 서명용. 반드시 직접 생성: openssl rand -hex 32
SECRET_KEY=change-me-to-random-32-bytes-hex

# Stage 1 개발용. true면 Discord OAuth 없이 가짜 사용자로 로그인 가능
DEV_LOGIN=true

# 신규 가입자 초기 자본금 (KRW)
INITIAL_CASH_KRW=50000000

# 관리자 Discord ID (콤마구분, Stage 5에서 사용)
ADMIN_DISCORD_IDS=

# --- 서비스 포트 ---
WEB_PORT=3000
API_PORT=8000

# 웹에서 API 호출할 때 사용하는 베이스 URL (브라우저 기준)
NEXT_PUBLIC_API_BASE=http://localhost:8000

# 서버사이드(SSR/내부 컨테이너간) API URL
API_INTERNAL_BASE=http://api:8000

# --- DB ---
# SQLite 파일 경로 (컨테이너 내부 경로). 호스트 ./data 와 마운트됨
DATABASE_URL=sqlite:////data/papertrade.db

# --- Discord OAuth (Stage 5에서 채움) ---
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback
DISCORD_BOT_TOKEN=

# --- KIS (Stage 2에서 채움) ---
# vts = 모의투자, real = 실전 (시세조회만)
KIS_ENV=vts
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT_NO=
